@page "/Profile"
@using Blazorise.Extensions
@using FightingFlowDotNet.Clients
@using Firebase.Auth

@inject FirebaseClientFactory FirebaseClientFactory
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject IConfiguration Config

<Card Class="glass-card glass-panel">
<CardBody>
    <Div Flex="Flex.Column">
        <Div Flex="Flex.Row.JustifyContent.Between.AlignItems.Center">
            <Heading Size="HeadingSize.Is3" TextColor="TextColor.Light">Your Profile</Heading>

            <Button Color="Color.Secondary"
                    TextColor="TextColor.Light"
                    @onclick="RequestLogout"
                    Width="Width.Is25">
                Logout
            </Button>
        </Div>

        <Blazorise.Text TextColor="TextColor.Light">Under construction...</Blazorise.Text>

        @if (!ErrorMessage.IsNullOrEmpty())
        {
            <Blazorise.Text TextColor="TextColor.Light">@(ErrorMessage)</Blazorise.Text>
        }
    </Div>
</CardBody>
</Card>

<Modal @ref="_confirmLogoutModal" Class="glass-modal">
    <ModalContent>
        <ModalHeader>
            <ModalTitle>Log out?</ModalTitle>
            <CloseButton Clicked="CancelLogout"/>
        </ModalHeader>
        <ModalBody>
            You'll need to sign in again to get back to your profile.
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Secondary" Clicked="CancelLogout">Cancel</Button>
            <Button Color="Color.Primary" TextColor="TextColor.Light" Clicked="ConfirmLogout">Logout</Button>
        </ModalFooter>
    </ModalContent>
</Modal>

@code {
    private IJSObjectReference? FirebaseModule { get; set; }
    private string ErrorMessage { get; set; } = "";
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            FirebaseModule = await Js.InvokeAsync<IJSObjectReference>(
                "import", "./js/firebaseAuth.js");

            await FirebaseModule.InvokeAsync<IJSObjectReference>("initFirebase", new
            {
                apiKey = Config["Firebase:ApiKey"],
                authDomain = Config["Firebase:AuthDomain"],
                projectId = Config["Firebase:ProjectId"],
                storageBucket = Config["Firebase:StorageBucket"],
                messagingSenderId = Config["Firebase:MessagingSenderId"],
                appId = Config["Firebase:AppId"],
            });
        }
    }

    private Modal? _confirmLogoutModal;

    private void RequestLogout() => _confirmLogoutModal?.Show();

    private void CancelLogout() => _confirmLogoutModal?.Hide();

    private async Task ConfirmLogout()
    {
        _confirmLogoutModal?.Hide();
        await Logout();
    }

    private async Task Logout()
    {
        if (FirebaseModule != null)
        {
            try {
                await FirebaseModule.InvokeVoidAsync("signOut");
                Navigation.NavigateTo("/", forceLoad: true);
            }
            catch (Exception ex)
            {
                ErrorMessage = "Logout has failed...";
                Console.WriteLine(ex.Message);
            }
        }
    }
}