@page "/Editor/{Game}/{Fighter}/{ComboId}/{EditMode:bool}"

@using System.Security.Claims
@using System.Text.Json
@using Blazorise.Extensions
@using FightingFlowDotNet.Clients
@using FightingFlowDotNet.Components.Helpers
@using FightingFlowDotNet.Components.Reusable
@using FightingFlowDotNet.Components.Reusable.Editor
@using FightingFlowDotNet.Models
@using FightingFlowDotNet.Resources
@using Microsoft.AspNetCore.Components.Authorization
@using Firebase.Auth

@inject FirestoreGetter FirestoreGetter
@inject NavigationManager Navigation

<PageTitle>Combo Editor</PageTitle>

@if (_saveError is not null)
{
    <Alert Color="Color.Danger" Class="glass-alert">
        <Div Flex="Flex.Row.JustifyContent.Between.AlignItems.Center">
            <Text TextColor="TextColor.Light">Couldn't save this combo. @_saveError</Text>
            <CloseButton Clicked="@(() => _saveError = null)"/>
        </Div>
    </Alert>
}

<Div Flex="Flex.Column.AlignContent.Center"
     Gap="Gap.Is4"
     Padding="Padding.Is2"
     Class="combo-editor-layout">
    <Div Flex="Flex.Column.JustifyContent.Center.AlignContent.Center"
         Gap="Gap.Is4"
         Class="combo-editor-panel">
        
        <Div Flex="Flex.Row.AlignItems.Center.JustifyContent.Between"
             Gap="Gap.Is2"
             Class="combo-editor-fighter-header"
             Style="cursor: pointer;"
             @onclick="RequestLeaveEditor">
            <Heading2 Margin="Margin.Is0" Style="font-size: 2.25rem;">@Fighter</Heading2>
            <img src="@GetFighterImageUrl()"
                 alt="@Fighter"
                 height="75" width="75"
                 style="object-fit: contain;"/>
        </Div>

        <ComboDisplay DisplayCombo="DisplayCombo"
                               UpdateEditorIndex="UpdateEditorIndex"
                               EditorIndex="EditorIndex"
                               ItemSelected="ItemSelected"
                               MoveList="_moveList"
                               EditMode="true"/>

        <ComboEditorButtons DeleteMove="DeleteMove"
                            AddBreak="AddBreak"
                            ClearMoves="ClearMoves"
                            SaveCombo="SaveCombo"
                            CanSave="_isAuthenticated"/>

        <ComboMetaFields ComboTitle="@ComboTitle"
                         ComboDamage="@ComboDamage"
                         ComboDifficulty="ComboDifficulty"/>
    </Div>

    <Div Flex="Flex.Column.JustifyContent.Start"
         Gap="Gap.Is4"
         Class="combo-selector-list">
        @foreach (var type in _types)
        {
            <MoveSelector Moves="_moveList"
                          Type="@type"
                          CharacterName="@(Fighter)"
                          AddMove="AddMove"/>
        }
    </Div>
</Div>

<Modal @ref="_confirmLeaveModal" Class="glass-modal">
    <ModalContent>
        <ModalHeader>
            <ModalTitle>Leave the editor?</ModalTitle>
            <CloseButton Clicked="CancelLeaveEditor"/>
        </ModalHeader>
        <ModalBody>
            Leaving now will take you back to the combo list and any unsaved changes to this combo will be lost. Continue?
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Secondary" Clicked="CancelLeaveEditor">Cancel</Button>
            <Button Color="Color.Primary" TextColor="TextColor.Light" Clicked="ConfirmLeaveEditor">Leave Editor</Button>
        </ModalFooter>
    </ModalContent>
</Modal>


@code {
    [Parameter] public string Game { get; set; } = "";
    [Parameter] public string Fighter { get; set; } = "";
    [Parameter] public string ComboId { get; set; } = "";
    [Parameter] public bool EditMode { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; }

    private string LastComboId { get; set; } = "";
    private bool _lastEditMode;

    private string ComboTitle { get; set; } = "";
    private int ComboDamage { get; set; } = 0;
    private int ComboDifficulty { get; set; } = 0;

    private int EditorIndex { get; set; }
    private bool ItemSelected { get; set; } = false;

    private List<Move> _moveList = [];
    private List<string> _types = [];

    private DisplayCombo DisplayCombo { get; set; } = new(new Combo());
    private string? _saveError;
    private bool _isAuthenticated;

    private Fighter? _chosenFighter;
    private Modal? _confirmLeaveModal;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask;
        _isAuthenticated = authState.User.Identity is { IsAuthenticated: true };
    }

    private string GetFighterImageUrl()
    {
        return $"./images/{_chosenFighter?.ImageId}.png";
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!RendererInfo.IsInteractive) return;

        _chosenFighter = Game switch
        {
            "Tekken 8" => Tekken8.Fighters.FirstOrDefault(f => f.Name == Fighter),
            "Street Fighter 6" => StreetFighter6.Fighters.FirstOrDefault(f => f.Name == Fighter),
            "Mortal Kombat 1" => MortalKombat1.Fighters.FirstOrDefault(f => f.Name == Fighter),
            _ => null
        };

        if (ComboId == LastComboId && EditMode == _lastEditMode)
        {
            return;
        }
        
        LastComboId = ComboId;
        _lastEditMode = EditMode;
        
        if (EditMode)
        {
            var combo = await GetComboFromFb();
            DisplayCombo = new DisplayCombo(combo);
        }
        else
        {
            DisplayCombo = new DisplayCombo(new Combo
            {
                Id = Guid.NewGuid().ToString(),
                Title = ComboTitle,
                Fighter = Fighter,
                Game = Game,
                CreatedBy = await GetUsername(),
                CreatedOn = DateOnly.FromDateTime(DateTime.Now).ToShortDateString(),
                ControlType = Game
            });
        }
        
        EditorIndex = DisplayCombo.Combo.Moves.Count - 1;

        _moveList = ListPopulator.ReturnMoveList(Game);
        _types = ListPopulator.ReturnTypes(Game);
    }

    private void NavigateToComboViewer()
    {
        Navigation.NavigateTo($"/{Game}/{Fighter}");
    }

    private void RequestLeaveEditor() => _confirmLeaveModal?.Show();

    private void CancelLeaveEditor() => _confirmLeaveModal?.Hide();

    private void ConfirmLeaveEditor()
    {
        _confirmLeaveModal?.Hide();
        NavigateToComboViewer();
    }

    private async Task<string> GetUsername()
    {
        var authState = await AuthStateTask;
        var uid = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        
        if (string.IsNullOrEmpty(uid)) return "Unknown User";

        var customUser = await FirestoreGetter.GetUser(uid);
        return customUser.Username;
    }

    private void UpdateEditorIndex(int index)
    {
        if (index == EditorIndex && ItemSelected)
        {
            ItemSelected = false;
            return;
        }
        EditorIndex = index;
        ItemSelected = true;
    }

    private async Task<Combo> GetComboFromFb()
    {
        return await FirestoreGetter.GetCombo(Fighter, ComboId);
    }

    private async Task SaveCombo()
    {
        _saveError = null;

        var authState = await AuthStateTask;
        if (authState.User.Identity is not { IsAuthenticated: true })
        {
            _isAuthenticated = false;
            _saveError = "You need to be logged in.";
            return;
        }

        try
        {
            await FirestoreGetter.SaveCombo(DisplayCombo);

            Navigation.NavigateTo($"/{Game}/{Fighter}");
        }
        catch (Exception e)
        {
            Console.WriteLine($"Failed to save combo: {e.Message}");
            _saveError = "Please try again.";
        }
    }

    public void AddMove(Move? move)
    {
        try
        {
            if (move is null) throw new ArgumentException("Move is null");
            
            if (ItemSelected)
            {
                Console.WriteLine($"Adding {move.Name} to Combo at the {EditorIndex} index");
                DisplayCombo.Combo.Moves.Insert(EditorIndex + 1, move.Notation);
            }
            else
            {
                Console.WriteLine($"Adding {move.Name} to end of Combo");
                DisplayCombo.Combo.Moves.Add(move.Notation);
            }

            Console.WriteLine($"{DisplayCombo.Combo.Moves.Last()} Added");
            Console.WriteLine($"Moves: {JsonSerializer.Serialize(DisplayCombo.Combo.Moves)}");
        }
        catch (Exception e)
        {
            Console.WriteLine(e.Message);
        }
    }

    public void DeleteMove()
    {
        try
        {
            Console.WriteLine(DisplayCombo.Combo.Moves.Count);
            if (DisplayCombo.Combo.Moves.IsNullOrEmpty())
                throw new IndexOutOfRangeException("List is empty");
            DisplayCombo.Combo.Moves.RemoveAt(
                ItemSelected ? EditorIndex : DisplayCombo.Combo.Moves.Count - 1);
        }
        catch (Exception e)
        {
            Console.WriteLine(e.Message);
        }
    }

    public void AddBreak()
    {
        if (ItemSelected)
        {
            DisplayCombo.Combo.Moves.Insert(EditorIndex + 1, "►");
            return;
        }
        DisplayCombo.Combo.Moves.Add("►");
    }

    public void ClearMoves()
    {
        DisplayCombo.Combo.Moves.Clear();
    }
}
