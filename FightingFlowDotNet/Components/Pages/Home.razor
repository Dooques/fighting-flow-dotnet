@page "/"
@using FightingFlowDotNet.Clients
@using FightingFlowDotNet.Components.Reusable
@using FightingFlowDotNet.Models.Enums
@using FightingFlowDotNet.Models
@using FightingFlowDotNet.Models.State
@using FightingFlowDotNet.Resources
@inject FirestoreGetter FbGetter
@inject GameSelectedState GameState
@implements IDisposable

<PageTitle>Fighting Flow</PageTitle>

<Div Flex="Flex.Column"
     Gap="Gap.Is1">
    
    <Heading1 hidden="true">
        Fighting <Span TextColor="TextColor.Primary">Flow</Span>
    </Heading1>

    <Div Margin="Margin.Is5.FromBottom"
         Style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 2rem;">
        @foreach (var fighter in Fighters)
        {
            <CharacterCard Fighter="@(fighter)"/>
        }
    </Div>
</Div>

@code {
    private IReadOnlyList<Fighter> Fighters { get; set; } = Tekken8.Fighters;
    protected override void OnInitialized()
    {
        GameState.OnChange += OnGameStateChanged;

        Fighters = FightersFor(GameState.GameType);

        if (GameState.GameType == GameType.TEKKEN8 &&
            GameState.BackgroundImage is null)
            GameState.SetBackground(
                Tekken8.StageImages[Random.Shared.Next(Tekken8.StageImages.Count)]);
    }

    private static IReadOnlyList<Fighter> FightersFor(GameType gameType) => gameType switch
    {
        GameType.STREETFIGHTER6 => StreetFighter6.Fighters,
        GameType.MORTALKOMBAT1 => MortalKombat1.Fighters,
        _ => Tekken8.Fighters
    };

    private void OnGameStateChanged()
    {
        Fighters = FightersFor(GameState.GameType);

        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        GameState.OnChange -= OnGameStateChanged;
    }
}
