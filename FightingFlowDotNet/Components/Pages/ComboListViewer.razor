@page "/{Game}/{Name}"

@using System.Runtime.Serialization
@using FightingFlowDotNet.Clients
@using FightingFlowDotNet.Components.Helpers
@using FightingFlowDotNet.Components.Reusable
@using FightingFlowDotNet.Models
@using FightingFlowDotNet.Resources
@inject FirestoreGetter FirestoreGetter
@inject NavigationManager Navigation

<PageTitle>Combo Viewer</PageTitle>

<Row RowColumns="RowColumns.Are2">
    <Column Width="Width.Is75"
            Flex="Flex.Column"
            Class="combo-viewer-list">
        @if (ComboList.Any())
        {
            @foreach (var combo in ComboList)
            {
                <Div>
                    <ComboDisplayWithButtons
                        DisplayCombo="combo"
                        ChosenFighter="@(ChosenFighter ?? new Fighter())"
                        Username="@(GetUsername(combo.Combo.CreatedBy))"
                        MoveList="MoveList"/>
                </Div>
            }
        }
        else
        {
            <Div Class="combo-empty-state">
                <p>No combos to be found...</p>
            </Div>
        }
    </Column>

    <Column Width="Width.Is25" Flex="Flex.Column.AlignItems.Center">
        <CharacterCardDetailed ChosenFighter="ChosenFighter"/>
    </Column>
</Row>

<script type="text/javascript">
    ScrollElementIntoView = {}
</script>

@code {
    [Parameter] 
    public string? Name { get; set; }
    [Parameter]
    public string? Game { get; set; }
    
    private Fighter? ChosenFighter { get; set; }
    private List<CustomUserInfo> UsersList { get; set; } = [];
    private List<DisplayCombo> ComboList { get; set; } = [];
    private List<Move> MoveList { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive) return;
        
        ChosenFighter = Game switch
        {
            "Tekken 8" => Tekken8.Fighters.FirstOrDefault(f => f.Name == Name),
            "Street Fighter 6" => StreetFighter6.Fighters.FirstOrDefault(f => f.Name == Name),
            "Mortal Kombat 1" => MortalKombat1.Fighters.FirstOrDefault(f => f.Name == Name),
            _ => throw new ArgumentOutOfRangeException(nameof(Game), Game, null)
        };

        Console.WriteLine($"ChosenFighter: {ChosenFighter?.Name}");
        
        if (ChosenFighter == null) return;
        
        var comboList = await FirestoreGetter.GetCombos(ChosenFighter.Name);
        
        ComboList.AddRange(
            from combo in comboList
            select new DisplayCombo(combo)
        );
        
        UsersList = await FirestoreGetter.GetUsers();
        MoveList = ListPopulator.ReturnMoveList(Game);
    }

    private string GetUsername(string userId)
    {
        var authDetailsUsername = UsersList.FirstOrDefault(u => 
            u.UserId == userId)?.Username;
        return authDetailsUsername ?? "Invalid Username";
    }

    private string GetPhotoUrl()
    {
        return $"./images/{ChosenFighter?.ImageId}.png";
    }
}
