@using FightingFlowDotNet.Components.Helpers
@using FightingFlowDotNet.Models

@if (MoveStyle.IsColored(Move?.Type))
{
    <Button Background="@MoveStyle.GetBackground(Move?.Type)"
            Type="ButtonType.Button"
            TextColor="TextColor.White"
            Class="@MoveStyle.GetToneClass(Move?.Type)"
            @onclick="HandleAddMove">
        <Text TextWeight="TextWeight.Bold">@Move?.Name</Text>
    </Button>
}
else
{
    @if (Move != null)
    {
        <Button Type="ButtonType.Button">
            <img src="@GetMoveImage(Move)"
                 alt="@MoveStyle.FormatName(Move.Name)"
                 title="@MoveStyle.FormatName(Move.Name)"
                 height="40" width="40"
                 @onclick="HandleAddMove"/>
        </Button>
    }
}

@code {

    [Parameter] public Move? Move { get; set; }
    [Parameter] public EventCallback<Move> AddMove { get; set; }

    private async Task HandleAddMove()
    {
        if (AddMove.HasDelegate && Move != null)
        {
            Console.WriteLine($"Sending {Move.Name} from MoveButton");
            await AddMove.InvokeAsync(Move);
        }
        else
        {
            Console.WriteLine("Move is null");
        }
    }

    private static string GetMoveImage(Move move)
    {
        var id = string.IsNullOrEmpty(move.ImageId) ? move.Name : move.ImageId;
        return $"./images/{id}.png";
    }
}
