@using System.Reflection.Metadata
@inject NavigationManager Navigation
<Div Flex="Flex.Row">
    <Button
        Color="Color.Light"
        Width="Width.Is25"
        Margin="Margin.Is4.FromEnd"
        Padding="Padding.Is3.OnX"
        TextWeight="TextWeight.Bold"
        Clicked="AddBreak"
        Outline>
        Break
    </Button>

    <Button Color="Color.Light"
            Width="Width.Is25"
            Margin="Margin.Is4.FromEnd"
            Padding="Padding.Is3.OnX"
            TextWeight="TextWeight.Bold"
            Clicked="HandleDelete"
            Outline
            >
        Delete
    </Button>

    <Button Color="Color.Light"
            Width="Width.Is25"
            Margin="Margin.Is4.FromEnd"
            Padding="Padding.Is3.OnX"
            TextWeight="TextWeight.Bold"
            Clicked="RequestClear"
            Outline>
        Clear
    </Button>

    <Button Color="Color.Primary"
            Width="Width.Is25"
            Padding="Padding.Is3.OnX"
            TextWeight="TextWeight.Bold"
            Clicked="RequestSave">
        Save
    </Button>
</Div>

<Modal @ref="_confirmClearModal" Class="glass-modal">
    <ModalContent>
        <ModalHeader>
            <ModalTitle>Clear all moves?</ModalTitle>
            <CloseButton Clicked="CancelClear"/>
        </ModalHeader>
        <ModalBody>
            This removes every move currently in the combo. This can't be undone.
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Secondary" Clicked="CancelClear">Cancel</Button>
            <Button Color="Color.Danger" TextColor="TextColor.Light" Clicked="ConfirmClear">Clear Moves</Button>
        </ModalFooter>
    </ModalContent>
</Modal>

<Modal @ref="_confirmSaveModal" Class="glass-modal">
    <ModalContent>
        <ModalHeader>
            <ModalTitle>Save this combo?</ModalTitle>
            <CloseButton Clicked="CancelSave"/>
        </ModalHeader>
        <ModalBody>
            This saves the combo as it currently appears.
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Secondary" Clicked="CancelSave">Cancel</Button>
            <Button Color="Color.Primary" TextColor="TextColor.Light" Clicked="ConfirmSave">Save Combo</Button>
        </ModalFooter>
    </ModalContent>
</Modal>

<Modal @ref="_signInRequiredModal" Class="glass-modal">
    <ModalContent>
        <ModalHeader>
            <ModalTitle>Sign in required</ModalTitle>
            <CloseButton Clicked="CancelSignIn"/>
        </ModalHeader>
        <ModalBody>
            You need to be signed in to save a combo.
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Secondary" Clicked="CancelSignIn">Cancel</Button>
            <Button Color="Color.Primary" TextColor="TextColor.Light" Clicked="GoToLogin">Log In</Button>
        </ModalFooter>
    </ModalContent>
</Modal>

@code {
    [Parameter] public EventCallback DeleteMove {get; set; }
    [Parameter] public EventCallback AddBreak { get; set; }
    [Parameter] public EventCallback ClearMoves { get; set; }
    [Parameter] public EventCallback SaveCombo { get; set; }
    [Parameter] public bool CanSave { get; set; } = true;

    private Modal? _confirmClearModal;
    private Modal? _confirmSaveModal;
    private Modal? _signInRequiredModal;

    private async Task HandleDelete()
    {
        if (DeleteMove.HasDelegate)
        {
            await DeleteMove.InvokeAsync();
        }
    }

    private void RequestClear() => _confirmClearModal?.Show();

    private void CancelClear() => _confirmClearModal?.Hide();

    private async Task ConfirmClear()
    {
        _confirmClearModal?.Hide();
        if (ClearMoves.HasDelegate)
        {
            await ClearMoves.InvokeAsync();
        }
    }

    private void RequestSave()
    {
        if (!CanSave)
        {
            _signInRequiredModal?.Show();
            return;
        }
        _confirmSaveModal?.Show();
    }

    private void CancelSave() => _confirmSaveModal?.Hide();

    private async Task ConfirmSave()
    {
        _confirmSaveModal?.Hide();
        if (SaveCombo.HasDelegate)
        {
            await SaveCombo.InvokeAsync();
        }
    }

    private void CancelSignIn() => _signInRequiredModal?.Hide();

    private void GoToLogin()
    {
        _signInRequiredModal?.Hide();
        Navigation.NavigateTo("/login");
    }
}
