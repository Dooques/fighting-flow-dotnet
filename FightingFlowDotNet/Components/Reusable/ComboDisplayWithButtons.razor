@using System.Text.Json
@using FightingFlowDotNet.Models

<Column Gap="Gap.Is1"
        Height="Height.Max100"
        Class="combo-item combo-viewer-shell"
        Padding="Padding.Is4">
    
    <Heading4>@DisplayCombo?.Combo.Title</Heading4>

    <ComboDisplayNoButtons DisplayCombo="DisplayCombo"
                           MoveList="MoveList"
                           EditMode="false"/>

    <Divider/>

    <Container Flex="Flex.Row.JustifyContent.Between.AlignItems.Center"
               Gap="Gap.Is2">
        <Div class="d-flex flex-column">
            <Text>Damage: @DisplayCombo?.Combo.Damage</Text>
            <Text>Created By: @Username</Text>
        </Div>

        <Div Flex="Flex.Row.AlignContent.Start.JustifyContent.Center"
             Gap="Gap.Is3">
            <Button Type="ButtonType.Link"
                    To="@HandleNavigation()"
                    Color="Color.Secondary">
                Edit
            </Button>
            <Button Type="ButtonType.Link"
                    Color="Color.Primary"
                    TextColor="TextColor.Light"
                    To="#">
                Share
            </Button>
        </Div>

        <Div Flex="Flex.Column.AlignItems.Center.JustifyContent.Center">
            <Text TextWeight="TextWeight.Bold">Ki: @DisplayCombo?.Ki</Text>
            <Button>
                <img class="img" src="images/p.png" height="32" width="32" alt="Like Button"/>
            </Button>
        </Div>
    </Container>
</Column>

@code {
    [Parameter] 
    public DisplayCombo? DisplayCombo { get; set; }
    [Parameter] 
    public Fighter ChosenFighter { get; set; } = new();
    [Parameter] 
    public string Username { get; set; } = "";
    [Parameter] 
    public EventCallback GetEditorUrl { get; set; }
    [Parameter] 
    public List<Move> MoveList { get; set; } = [];

    protected override Task OnInitializedAsync()
    {
        Console.WriteLine($"Combo: {DisplayCombo?.Combo.Title}");
        Console.WriteLine($"Moves: {JsonSerializer.Serialize(DisplayCombo?.Combo.Moves)}");
        return base.OnInitializedAsync();
    }
    
    private string HandleNavigation()
    {
        return $"/Editor/{ChosenFighter.Game}/{ChosenFighter.Name}/{DisplayCombo?.Combo.Id}/True";
    }
}
